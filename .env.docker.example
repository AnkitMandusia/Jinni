# Docker-only settings (copy to .env next to docker-compose.yml). NEVER commit .env.
# App credentials (Paytm, Firebase, R2, SMS, SECRET_KEY, ...) live in superapp-backend/.env — see
# superapp-backend/.env.example. Compose loads that file into the api/migrate containers and only
# overrides DATABASE_URL / REDIS_URL / FIREBASE_CREDENTIALS_PATH / CORS_ORIGINS / DEBUG.

# URL-safe characters only (letters/digits/-_): embedded in DATABASE_URL.
POSTGRES_USER=jinni
POSTGRES_PASSWORD=change-me-use-a-long-random-string
POSTGRES_DB=jinni

# false in production (then SECRET_KEY in superapp-backend/.env must be >= 32 chars)
DEBUG=false
CORS_ORIGINS=http://localhost:8080

# --- production overlay (docker-compose.prod.yml) ---
# DOMAIN=jinni.example.com
# ACME_EMAIL=you@example.com
