# Copy to .env (same folder as docker-compose.yml) and fill in. NEVER commit .env.
# Use URL-safe characters in POSTGRES_PASSWORD (letters/digits/-_ only): it is embedded in DATABASE_URL.

POSTGRES_USER=jinni
POSTGRES_PASSWORD=change-me-use-a-long-random-string
POSTGRES_DB=jinni

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# false in production. When false, SECRET_KEY must be >= 32 chars (startup refuses otherwise).
DEBUG=false
# Exposes OTPs for testing — keep false in production once a real SMS/Firebase path is live.
OTP_DEBUG=false
# Comma-separated origins allowed by CORS. The bundled admin is same-origin so this can stay tight.
CORS_ORIGINS=http://localhost:8080

# Public HTTPS URL of the API as Paytm sees it (needed for online payments)
PAYTM_ENVIRONMENT=staging
PAYTM_MERCHANT_ID=
PAYTM_MERCHANT_KEY=
PAYTM_WEBSITE_NAME=WEBSTAGING
PAYTM_CALLBACK_URL=

# Push notifications: place the service-account JSON at ./secrets/firebase-credentials.json
FIREBASE_API_KEY=

# Product images (Cloudflare R2)
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_CDN_BASE_URL=

# Jinni AI fallback (optional)
GEMINI_API_KEY=

# SMS_PROVIDER: console | msg91 | twilio
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
WABA_TOKEN=
WABA_PHONE_ID=
META_APP_SECRET=

# --- production overlay (docker-compose.prod.yml) ---
# DOMAIN=jinni.example.com
# ACME_EMAIL=you@example.com
