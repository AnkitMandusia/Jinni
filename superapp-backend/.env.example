# ── Delivery Confirmation OTP (Meta WhatsApp + SMS) ───────────────────────────
WABA_TOKEN=
WABA_PHONE_ID=
WABA_TEMPLATE_NAME=delivery_otp
WABA_TEMPLATE_LANG=en_US
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=merefood_wa_verify

DELIVERY_OTP_EXPIRY_SECONDS=300
DELIVERY_OTP_RESEND_COOLDOWN=60
DELIVERY_OTP_MAX_ATTEMPTS=5
DELIVERY_OTP_MAX_RESENDS=3
WHATSAPP_FALLBACK_TIMEOUT_SECONDS=45

# SMS: console | msg91 | twilio
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=MEREFD
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Jinni AI — Gemini Flash-Lite fallback (used only when local intent
# confidence < 0.70 and the monthly budget gate below is open)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
JINNI_MONTHLY_BUDGET_PAISE=50000
