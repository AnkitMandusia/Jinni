{
  "expo": {
    "name": "Jinni",
    "slug": "jinni-superapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#FFFCF5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.superapp.mobile",
      "buildNumber": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5E2FB8"
      },
      "package": "com.superapp.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      "expo-camera",
      "expo-image-picker",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#6366F1",
          "androidMode": "default",
          "androidCollapsedTitle": "New Order Alert"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Jinni ko apni wish bolne ke liye mic access chahiye.",
          "speechRecognitionPermission": "Jinni apki awaaz ko text me badlega, sirf tabhi jab aap mic dabayenge.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "555bbb61-9722-4f61-b699-287faaebaeaa"
      }
    }
  }
}
